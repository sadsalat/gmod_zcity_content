"VertexlitGeneric"
{
	"$basetexture" "blackterios_vehicles/shared/vehicle_generic_doorshut"

	"$bumpmap" "blackterios_vehicles/shared/vehicle_generic_doorshut_normal"
	"$phong" "1"
	"$phongexponent" "15"
	"$phongboost"	"2"
	"$envmap" "env_cubemap"
	"$envmapfresnel" "1.7"
	"$phongfresnelranges" "[.4 .7 4]"
	"$envmaptint" "[0.5 0.5 0.5]"
	"$phongfix" "{20 20 20}"

	Proxies
	{
		Equals
		{
			srcVar1	$color
			resultVar	$phongtint
		}
		Add
		{
			srcVar1 $phongfix
			srcVar2 $phongtint
			resultVar $phongtint
		}
	}
}
