"VertexlitGeneric"
{
	"$basetexture" "blackterios_vehicles/shared/vehicle_generic_tyrewallblack"

	"$bumpmap" "blackterios_vehicles/shared/vehicle_generic_tyrewallblack_normal"
	"$phong" "1"
	"$phongexponent" "15"
	"$phongboost"	"0.1"
	"$envmap" "env_cubemap"
	"$envmapfresnel" "2"
	"$phongfresnelranges" "[.3 .3 3]"
	"$envmaptint" "[0.001 0.001 0.001]"
	"$colorfix" "{255 255 255 }"
	Proxies
	{
		Equals
		{
			srcVar1 $color
			resultVar $phongtint
		}
		Add
		{
			srcVar1 $phongfix
			srcVar2 $phongtint
			resultVar $phongtint
		}		
		Equals
		{
			srcVar1 $colorfix
			resultVar	$color
		}
		Equals
		{
			srcVar1 $color
			resultVar $phongtint
		}
	}
}

