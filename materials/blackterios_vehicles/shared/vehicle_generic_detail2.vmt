"VertexlitGeneric"
{
	"$basetexture" "blackterios_vehicles/shared/vehicle_generic_detail2"
	"$bumpmap" "blackterios_vehicles/shared/vehicle_generic_detail2_normal"
	"$phong" "1"
	"$phongexponent" "1"
	"$phongboost"	"1"
	"$envmap" "env_cubemap"
	"$envmapfresnel" "0.1"
	"$phongfresnelranges" "[.1 .1 1]"
	"$envmaptint" "[0.001 0.001 0.001]"
	"$phongfix" "{10 10 10}"
	"$colorfix" "{255 255 255 }"
	Proxies
	{
		Equals
		{
			srcVar1 $color
			resultVar $phongtint
		}
		Add
		{
			srcVar1 $phongfix
			srcVar2 $phongtint
			resultVar $phongtint
		}		
		Equals
		{
			srcVar1 $colorfix
			resultVar	$color
		}
		Equals
		{
			srcVar1 $color
			resultVar $phongtint
		}
	}
}
