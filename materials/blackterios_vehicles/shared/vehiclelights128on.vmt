"VertexlitGeneric"
{
	"$basetexture" "blackterios_vehicles/shared/vehiclelights128"
	"$allowdiffusemodulation" "false"

	$emissiveBlendEnabled "1"
	$emissiveBlendStrength "1"
	$emissiveBlendTexture "vgui/white"
	$emissiveBlendBaseTexture "blackterios_vehicles/shared/vehiclelights128on"
	$emissiveBlendFlowTexture "vgui/white"
	$emissiveBlendTint "[ 5 5 3 ]"
	$emissiveBlendScrollVector "[ 0 0 ]"

	"$nocull" "1"
	"$bumpmap" "blackterios_vehicles/shared/vehiclelights128_n"
	"$surfaceprop" "Metal"

	"$phong" "1"
	"$phongexponent" "1"
	"$phongboost"	"0.1"
	"$envmap" "env_cubemap"
	"$envmapfresnel" "0.3"
	"$phongfresnelranges" "[3 3 3]"
	"$envmaptint" "[0.02 0.02 0.02 ]"
	"$phongfix" "{255 255 255 }" 

	"$colorfix" "{255 255 255 }"
	Proxies
	{
		Equals
		{
			srcVar1 $color
			resultVar $phongtint
		}
		Add
		{
			srcVar1 $phongfix
			srcVar2 $phongtint
			resultVar $phongtint
		}		
		Equals
		{
			srcVar1 $colorfix
			resultVar	$color
		}
		Equals
		{
			srcVar1 $color
			resultVar $phongtint
		}
	}
}
